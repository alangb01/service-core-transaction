{
  "type": "record",
  "name": "WalletPaymentOccurredEvent",
  "namespace": "pe.nom.charlygastelo.app.shared.avro.dto",
  "fields": [
    { "name": "eventId", "type": "string" },
    { "name": "eventType", "type": "string" },
    { "name": "occurredAt", "type": "string" },
    { "name": "version", "type": "string" },
    { "name": "source", "type": "string" },


    { "name": "correlationId", "type": "string" },

    { "name": "customerId", "type": "string" },

    {
      "name": "sourceWalletId",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "targetWalletId",
      "type": ["null", "string"],
      "default": null
    },

    {
      "name": "sourceDebitCardId",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "targetDebitCardId",
      "type": ["null", "string"],
      "default": null
    },

    { "name": "amount", "type": "double" },
    { "name": "description", "type": "string" }
  ]
}
