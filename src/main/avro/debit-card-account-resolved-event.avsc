{
  "type": "record",
  "namespace": "pe.nom.charlygastelo.app.shared.avro.dto",
  "name": "DebitCardAccountsResolvedEvent",
  "fields": [
    { "name": "eventId", "type": "string" },
    { "name": "eventType", "type": "string", "default": "DEBIT_CARD_ACCOUNTS_RESOLVED" },
    { "name": "occurredAt", "type": "string" },
    { "name": "version", "type": "string", "default": "1.0" },
    { "name": "source", "type": "string" },

    { "name": "correlationId", "type": "string" },

    { "name": "transactionId", "type": "string" },

    { "name": "sourceDebitCardId", "type": "string" },
    { "name": "targetDebitCardId", "type": "string" },

    { "name": "sourceAccountId", "type": "string" },
    { "name": "targetAccountId", "type": "string" },

    { "name": "amount", "type": "string" }
  ]
}
