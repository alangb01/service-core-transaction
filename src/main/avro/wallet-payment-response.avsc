{
  "type": "record",
  "namespace": "pe.nom.charlygastelo.app.shared.avro.dto",
  "name": "WalletPaymentResponseEvent",
  "fields": [
    { "name": "eventId", "type": "string" },
    { "name": "eventType", "type": "string", "default": "WALLET_PAYMENT_RESPONSE" },
    { "name": "occurredAt", "type": "string" },
    { "name": "version", "type": "string", "default": "1.0" },
    { "name": "source", "type": "string" },

    { "name": "correlationId", "type": "string" },

    { "name": "status", "type": "string" },
    { "name": "message", "type": ["null", "string"], "default": null },

    { "name": "transactionId", "type": "string" },

    {
      "name": "sourceWalletId",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "targetWalletId",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "sourceDebitCardId",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "targetDebitCardId",
      "type": ["null", "string"],
      "default": null
    },

    { "name": "amount", "type": "double" }
  ]
}
